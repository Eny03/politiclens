# ==============================================================================
# PoliticLens - Configurazione Ambiente & Chiavi AI
# ==============================================================================
# PoliticLens funziona al 100% anche senza alcuna chiave API esterna grazie
# al Motore Euristico Istituzionale Offline (0€).
# Se desideri abilitare la generazione di testo avanzata con modelli LLM Cloud
# gratuiti o locali, imposta una delle seguenti opzioni:

# 1. Google Gemini Flash (Opzione Cloud Consigliata - Gratuita)
# Ottieni la chiave gratuita su: https://aistudio.google.com/
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# 2. Groq Cloud (Llama-3.3 70B ad altissima velocità - Gratuito)
# Ottieni la chiave gratuita su: https://console.groq.com/
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. Ollama Locale (100% privato e offline su questo PC)
# Avvia Ollama con 'ollama run qwen2.5:14b' o 'ollama run llama3.1'
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:14b

# Scheduler & Frequenza Scansione
INGESTION_INTERVAL_MINUTES=10
ENABLE_AUTO_SCHEDULER=true
